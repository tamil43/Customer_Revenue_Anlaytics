    "segment_summary = (\n",
    "    customer_df\n",
    "    .groupby(\"BehavioralSegment\")\n",
    "    .agg(\n",
    "        CustomerCount=(\"UserID\", \"nunique\"),\n",
    "        GrossRevenue=(\"GrossRevenue\", \"sum\"),\n",
    "        ReturnValue=(\"ReturnValue\", \"sum\"),\n",
    "        NetRevenue=(\"NetRevenue\", \"sum\")\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "segment_summary[\"CustomerShare\"] = (\n",
    "    segment_summary[\"CustomerCount\"] /\n",
    "    segment_summary[\"CustomerCount\"].sum()\n",
    ")\n",
    "\n",
    "segment_summary[\"GrossRevenueShare\"] = (\n",
    "    segment_summary[\"GrossRevenue\"] /\n",
    "    segment_summary[\"GrossRevenue\"].sum()\n",
    ")\n",
    "\n",
    "segment_summary[\"ReturnValueShare\"] = (\n",
    "    segment_summary[\"ReturnValue\"] /\n",
    "    segment_summary[\"ReturnValue\"].sum()\n",
    ")\n",
    "\n",
    "segment_summary[\"NetRevenueShare\"] = (\n",
    "    segment_summary[\"NetRevenue\"] /\n",
    "    segment_summary[\"NetRevenue\"].sum()\n",
    ")\n",
    "\n",
    "segment_summary.sort_values(\n",
    "    \"GrossRevenue\",\n",
    "    ascending=False\n",
    ")"
