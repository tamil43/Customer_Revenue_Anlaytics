    "# Thresholds based on the customer distributions we already calculated\n",
    "\n",
    "high_value_threshold = customer_df[\"GrossRevenue\"].quantile(0.75)\n",
    "\n",
    "active_threshold = 90\n",
    "\n",
    "return_risk_threshold = 0.05\n",
    "\n",
    "print(\"High-value threshold:\", high_value_threshold)\n",
    "print(\"Active threshold:\", active_threshold, \"days\")\n",
    "print(\"Return-risk threshold:\", return_risk_threshold)"
   ]
